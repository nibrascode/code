{
  "name": "nibras-arabic",
  "version": "1.1.0",
  "description": "Nibras Arabic - Ərəbcə öyrənmə tətbiqi (Capacitor Android)",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:apk": "pnpm run sync && cd android && ./gradlew assembleDebug",
    "build:play": "pnpm run sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1"
  }
}
