# Nibras X-Ray Server Configuration
PORT=8000
HOST=0.0.0.0
MAX_UPLOAD_MB=25
MAX_UNCOMPRESSED_MB=80

# Optional Database Persistence (PostgreSQL)
DATABASE_URL=postgresql://nibras:nibras_pass@localhost:5432/nibras_xray

# Server-Side AI Provider Keys (Never exposed to frontend!)
# External AI calls are disabled unless user explicitly grants consent per request
AI_DEFAULT_PROVIDER=local_deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
