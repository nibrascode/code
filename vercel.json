      "source": "/ar/calc",
      "destination": "/calc/index.html"
    },
    {
      "source": "/ru/calc",
      "destination": "/calc/index.html"
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 300
    }
  }
}
